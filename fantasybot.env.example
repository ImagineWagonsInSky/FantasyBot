# Copy to fantasybot.env (git-ignored) and fill in. Non-secret settings only:
# the encryption key and the Telegram bot token live in a Docker volume.

# From `./fb telegram chats` after you message your bot.
FANTASYBOT_TELEGRAM_CHAT_ID=

# Every write (bids, sales, lineups) is simulated until you set this to false.
FANTASYBOT_DRY_RUN=true

# Times in the briefing and alerts. Default: LaLiga's own clock (Europe/Madrid).
FANTASYBOT_TIMEZONE=

# Optional. Default: the first league on the account, and your team in it.
FANTASYBOT_LEAGUE_ID=
FANTASYBOT_TEAM_ID=

# Acting from Telegram: buttons under the briefing, each confirmed by you.
# Off by default. While FANTASYBOT_DRY_RUN=true, confirming only shows what
# would be sent. Needs the listener: ./fb listen start
FANTASYBOT_ACTIONS=off
# Which actions to offer (any of: lineup, bid, steal, raise, sell, relist, accept, decline,
# withdraw)
FANTASYBOT_ACTION_KINDS=lineup,bid,steal,raise,sell,relist,accept,decline,withdraw
# Optional limits of your own for real actions (0 = no limit). LaLiga's rules still apply.
FANTASYBOT_ACTION_MAX_MONEY=0
FANTASYBOT_ACTION_DAILY_LIMIT=0
# true if your league has shields (blindaje); otherwise raising a clause is the only protection
FANTASYBOT_SHIELDS=false

# Selling. The shop window is who the daily relist button lists so LaLiga makes
# an offer on each ("everyone", "bench" or "off"). Accept buttons only appear
# for offers at least this far above value (falling players: any premium).
FANTASYBOT_SHOP_WINDOW=everyone
FANTASYBOT_SELL_THRESHOLD=0.05
FANTASYBOT_STARTER_SELL_THRESHOLD=0.08

# Outside data (README, "Outside data"). Optional and free. Keys never go in
# this file: store them with ./fb secret set odds_api_key and
# ./fb secret set football_data_token
# Bookmaker regions for match odds; each extra region costs credits.
FANTASYBOT_ODDS_REGIONS=eu
# Probable lineups from futbolfantasy.com (no key; a few pages a day): true or false.
FANTASYBOT_LINEUPS=true

# The daily plan: Claude reads the briefing and picks what to do (README, "The daily plan").
# On once the key is stored with ./fb secret set anthropic_api_key. Your friends' names are
# never sent. "plan" sends only the plan (full briefing on /details, needs ./fb listen start);
# "both" sends the plan, then the full briefing.
FANTASYBOT_ADVISOR=true
FANTASYBOT_ADVISOR_MODEL=claude-opus-5-5
FANTASYBOT_ADVISOR_EFFORT=low
FANTASYBOT_BRIEFING_STYLE=plan
