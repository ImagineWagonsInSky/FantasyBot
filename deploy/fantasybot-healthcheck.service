[Unit]
Description=FantasyBot daily health check and briefing
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=fantasybot
Group=fantasybot
EnvironmentFile=/etc/fantasybot/fantasybot.env
# The leading - lets the briefing run even when the health check found problems
# (it has already alerted on Telegram).
ExecStart=-/opt/fantasybot/.venv/bin/fantasybot healthcheck
ExecStart=/opt/fantasybot/.venv/bin/fantasybot briefing
StateDirectory=fantasybot
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=10min

# Sandboxing: the service can write only its state directory, and the code
# under /opt is read-only to it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
