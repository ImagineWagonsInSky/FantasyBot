# /etc/fantasybot/fantasybot.env (owner root:fantasybot, mode 640).
# Non-secret settings only. Secrets live in their own files, below.
FANTASYBOT_STATE_DIR=/var/lib/fantasybot
FANTASYBOT_TOKEN_KEY_FILE=/etc/fantasybot/token_key
FANTASYBOT_TELEGRAM_BOT_TOKEN_FILE=/etc/fantasybot/telegram_bot_token
# Optional outside data; store them with `fantasybot secret set <name>`.
FANTASYBOT_ODDS_API_KEY_FILE=/etc/fantasybot/odds_api_key
FANTASYBOT_FOOTBALL_DATA_TOKEN_FILE=/etc/fantasybot/football_data_token
FANTASYBOT_TELEGRAM_CHAT_ID=

# Simulate every write (bids, sales, lineups) until you deliberately turn this off.
FANTASYBOT_DRY_RUN=true

# Optional. Default: the first league on the account, and your team in it.
#FANTASYBOT_LEAGUE_ID=
#FANTASYBOT_TEAM_ID=
#FANTASYBOT_COMPETITION_ID=1
