[Unit]
Description=FantasyBot kickoff guard (alerts only if the next jornada would cost points)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=fantasybot
Group=fantasybot
EnvironmentFile=/etc/fantasybot/fantasybot.env
ExecStart=/opt/fantasybot/.venv/bin/fantasybot guard
StateDirectory=fantasybot
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=5min

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
